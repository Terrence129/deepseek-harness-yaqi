{
  "name": "dsh-lifebase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only Lifebase archive queries as Harness tools.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
